# Frenkel-Ladd thermodynamic integration for alpha-TiAl whole cell
# Whole-system two-component version: Ti and Al are restrained separately,
# but the free energy is evaluated for the full interacting alpha-TiAl cell.

#--------------------------- Simulation variables -----------------------------#
# Initializes the random number generator.
variable         rnd equal round(random(0,999,${RANDOM}))

# Simulation control parameters.
variable         t_eq equal 200000      # Equilibration time [steps]
variable         t    equal 200000      # Switching time [steps]
variable         T    equal 500         # Temperature [K]

# Einstein spring constants [eV/A^2]
  variable k1 equal 1.815151646910256 #Ti TI spring constant of titanium eV/A^2
  variable k2 equal 1.952032987954400 #Al TI spring constant of aluminum eV/A^2
#------------------------------------------------------------------------------#


#---------------------------- Atomic setup ------------------------------------#
units            metal
atom_style       atomic

# Load equilibrated restart
read_restart     ../restart.400000.equil

# Species groups (disjoint partition of the full cell)
group            Ti type 1
group            Al type 2

# Interatomic potential
pair_style       meam
pair_coeff       * * ../../../../../MEAM/library_Ti6Al.meam Ti Al ../../../../../MEAM/TiAl.meam Ti Al
neigh_modify     delay 0
timestep         0.001
#------------------------------------------------------------------------------#


#----------------------------- Run simulation ---------------------------------#
# Integrator, Frenkel-Ladd springs, and thermostat
fix              f1 all nve
fix              f21 Ti ti/spring ${k1} ${t} ${t_eq} function 2
fix              f22 Al ti/spring ${k2} ${t} ${t_eq} function 2
fix              f3 all langevin ${T} ${T} 0.1 ${rnd} zero yes

# Thermo output
thermo_style     custom step temp pe etotal press vol
thermo           1000

# Optional species diagnostics
compute          pe01 Ti pe/atom
compute          pe02 Al pe/atom
compute          pe1 Ti reduce sum c_pe01
compute          pe2 Al reduce sum c_pe02

# Total integrand for FL switching
variable         dE     equal pe-(f_f21+f_f22)
variable         lambda equal f_f21[1]

# Optional species-resolved diagnostics only
variable         dE1 equal c_pe1-f_f21
variable         dE2 equal c_pe2-f_f22
variable         lambda1 equal f_f21[1]
variable         lambda2 equal f_f22[1]

# Initialize velocities
velocity         all create ${T} ${rnd} dist gaussian

#----------------------------- Forward integration ----------------------------#
dump             d0 all atom 1000 alphaTiAl_equil_${T}K.lammpstrj
run              ${t_eq}
undump           d0

# Total file used for final free-energy integration
fix              f40 all print 1 "${dE} ${lambda}" title "# dE_total [eV] lambda" screen no file data/total_forward_${T}K.dat

# Optional species diagnostic files
fix              f41 Ti print 1 "${dE1} ${lambda1}" title "# dE_Ti [eV] lambda" screen no file data/Ti_forward_${T}K.dat
fix              f42 Al print 1 "${dE2} ${lambda2}" title "# dE_Al [eV] lambda" screen no file data/Al_forward_${T}K.dat

dump             d1 all atom 1000 alphaTiAl_forward_${T}K.lammpstrj
run              ${t}
undump           d1

unfix            f40
unfix            f41
unfix            f42

#----------------------------- Backward integration ---------------------------#
run              ${t_eq}

fix              f40 all print 1 "${dE} ${lambda}" title "# dE_total [eV] lambda" screen no file data/total_backward_${T}K.dat

# Optional species diagnostic files
fix              f41 Ti print 1 "${dE1} ${lambda1}" title "# dE_Ti [eV] lambda" screen no file data/Ti_backward_${T}K.dat
fix              f42 Al print 1 "${dE2} ${lambda2}" title "# dE_Al [eV] lambda" screen no file data/Al_backward_${T}K.dat

dump             d2 all atom 1000 alphaTiAl_backward_${T}K.lammpstrj
run              ${t}
undump           d2
#------------------------------------------------------------------------------#
